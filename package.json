{
  "name": "gesso-studio",
  "version": "0.4.0",
  "description": "Open-source, local-first game art studio where your AI agent is the artist. MCP tools, a game-art knowledge base and a live studio for reviewing, versioning and exporting assets.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "The Gesso contributors",
  "homepage": "https://github.com/pin705/gesso-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pin705/gesso-studio.git"
  },
  "bugs": {
    "url": "https://github.com/pin705/gesso-studio/issues"
  },
  "keywords": [
    "game-art",
    "mcp",
    "ai",
    "game-development",
    "svg",
    "sprites",
    "ui-kit",
    "vfx",
    "nuxt"
  ],
  "bin": {
    "gesso": "bin/gesso.mjs"
  },
  "files": [
    "bin",
    ".output",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "node scripts/build-kit.mjs && nuxt build",
    "start": "node bin/gesso.mjs",
    "typecheck": "nuxt typecheck",
    "test": "node test/e2e.mjs",
    "prepare": "node scripts/build-kit.mjs && nuxt prepare",
    "kit": "node scripts/build-kit.mjs"
  },
