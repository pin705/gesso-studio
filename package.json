{
  "name": "game-art-studio",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source, local-first game art studio: your AI agent creates game-ready assets over MCP, guided by an art knowledge base; the studio is a live viewer.",
  "type": "module",
  "bin": {
    "game-art-mcp": "mcp/server.js"
  },
  "files": [
    "mcp",
    "knowledge",
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=20.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "mcp": "node mcp/server.js",
    "prepare": "vite build"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
