{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-art-studio.local/schema/asset-definition.json",
  "title": "Game Art Studio asset definition",
  "type": "object",
  "required": ["type", "id", "name", "width", "height", "seed", "version", "nodes"],
  "properties": {
    "type": { "const": "game-asset" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "height": { "type": "number", "exclusiveMinimum": 0 },
    "seed": { "type": "integer", "minimum": 0 },
    "version": { "const": 1 },
    "parameters": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "paint": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["kind", "stops"],
          "properties": {
            "kind": { "enum": ["linear", "radial"] },
            "stops": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["offset", "color"],
                "properties": {
                  "offset": { "type": "number", "minimum": 0, "maximum": 1 },
                  "color": { "type": "string" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["group", "rect", "rounded-rect", "circle", "ellipse", "line", "polygon", "star", "path", "arc", "text", "particle"] },
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fill": { "$ref": "#/$defs/paint" },
        "stroke": { "$ref": "#/$defs/paint" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "d": { "type": "string" },
        "text": { "type": "string" },
        "seed": { "type": "integer" },
        "roughness": { "type": "number" },
        "effects": { "type": "array", "items": { "type": "string" } },
        "mask": { "type": "string" },
        "clipPath": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
